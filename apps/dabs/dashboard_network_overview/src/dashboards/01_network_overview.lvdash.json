                }
              },
              "frame": {
                "showTitle": true,
                "title": "Avg Tx / Bloco"
              }
            }
          },
          "position": {"x": 2, "y": 0, "width": 2, "height": 3}
        },
        {
          "widget": {
            "name": "counter_gas_price",
            "queries": [

{
  "datasets": [
    {
      "name": "network_summary_24h",
      "displayName": "Resumo Rede — 24h",
      "query": "SELECT\n  SUM(block_count)                                    AS blocks_24h,\n  ROUND(AVG(avg_txs_per_block), 2)                    AS avg_tx_per_block,\n  ROUND(AVG(avg_gas_price_gwei), 4)                   AS avg_gas_price_gwei,\n  ROUND(AVG(avg_block_utilization_pct) * 100, 2)      AS avg_block_utilization_pct\nFROM dev.g_network.network_metrics_hourly\nWHERE hour_bucket >= current_timestamp() - INTERVAL 24 HOURS"
    },
    {
      "name": "hourly_trend",
      "displayName": "Tendência Horária — 7 dias",
      "query": "SELECT\n  hour_bucket,\n  block_count,\n  ROUND(avg_txs_per_block, 2)          AS avg_tx_per_block,\n  ROUND(avg_gas_price_gwei, 4)         AS avg_gas_price_gwei,\n  ROUND(tps_avg, 4)                    AS tps_avg\nFROM dev.g_network.network_metrics_hourly\nWHERE hour_bucket >= current_timestamp() - INTERVAL 7 DAYS\nORDER BY hour_bucket ASC"
    },
    {
      "name": "block_time_health",
      "displayName": "Saúde dos Tempos de Bloco",
      "query": "SELECT\n  ROUND(mean, 2)    AS mean_block_time_s,\n  ROUND(stddev, 2)  AS stddev_block_time_s,\n  ROUND(min, 2)     AS min_block_time_s,\n  ROUND(max, 2)     AS max_block_time_s,\n  gap_count\nFROM dev.g_network.block_production_health"
    }
  ],
  "pages": [
    {
      "name": "network_overview_page",
      "displayName": "Network Overview",
      "layout": [
        {
          "widget": {
            "name": "counter_blocks_24h",
            "queries": [
              {
                "name": "main",
                "query": {
                  "datasetName": "network_summary_24h",
                  "fields": [
                    {"name": "blocks_24h", "expression": "blocks_24h"}
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "blocks_24h",
                  "displayName": "Blocos (24h)"
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Blocos (24h)"
              }
            }
          },
          "position": {"x": 0, "y": 0, "width": 2, "height": 3}
        },
        {
          "widget": {
            "name": "counter_avg_tx",
            "queries": [
              {
                "name": "main",
                "query": {
                  "datasetName": "network_summary_24h",
                  "fields": [
                    {"name": "avg_tx_per_block", "expression": "avg_tx_per_block"}
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {

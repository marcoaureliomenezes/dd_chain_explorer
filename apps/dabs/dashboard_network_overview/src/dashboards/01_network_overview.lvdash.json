{
  "datasets": [
    {
      "name": "network_summary_24h",
      "displayName": "Resumo Rede — últimas 24h de dados",
      "query": "SELECT\n  SUM(block_count)                                    AS blocks_24h,\n  ROUND(AVG(avg_txs_per_block), 2)                    AS avg_tx_per_block,\n  ROUND(AVG(avg_gas_price_gwei), 4)                   AS avg_gas_price_gwei,\n  ROUND(AVG(avg_block_utilization_pct) * 100, 2)      AS avg_block_utilization_pct\nFROM (\n  SELECT *\n  FROM dev.g_network.network_metrics_hourly\n  ORDER BY hour_bucket DESC\n  LIMIT 24\n) recent"
    },
    {
      "name": "hourly_trend",
      "displayName": "Tendência Horária — últimos 7 dias de dados",
      "query": "SELECT\n  hour_bucket,\n  block_count,\n  ROUND(avg_txs_per_block, 2)          AS avg_tx_per_block,\n  ROUND(avg_gas_price_gwei, 4)         AS avg_gas_price_gwei,\n  ROUND(tps_avg, 4)                    AS tps_avg\nFROM (\n  SELECT *\n  FROM dev.g_network.network_metrics_hourly\n  ORDER BY hour_bucket DESC\n  LIMIT 168\n) recent\nORDER BY hour_bucket ASC"
    },
    {
      "name": "block_time_health",
      "displayName": "Saúde da Produção de Blocos",
      "query": "SELECT\n  hour_bucket,\n  block_count,\n  missed_slots_estimated,\n  ROUND(missed_slot_rate_pct, 2)   AS missed_slot_rate_pct,\n  ROUND(avg_slot_gap_sec, 2)       AS avg_slot_gap_sec,\n  max_slot_gap_sec,\n  gap_events_count\nFROM dev.g_network.block_production_health\nORDER BY hour_bucket DESC\nLIMIT 168"
    }
  ],
  "pages": [
    {
      "name": "network_overview_page",
      "displayName": "Network Overview",
      "layout": [
        {
          "widget": {
            "name": "counter_blocks_24h",
            "queries": [
              {
                "name": "main",
                "query": {
                  "datasetName": "network_summary_24h",
                  "fields": [
                    {"name": "blocks_24h", "expression": "blocks_24h"}
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "blocks_24h",
                  "displayName": "Blocos (24h)"
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Blocos (24h)"
              }
            }
          },

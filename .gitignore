.hypothesis/
.idea
.ipynb_checkpoints
__pycache__

# Python build artifacts (generic — covers all subdirectories)
build/
dist/
*.egg-info/
__pycache__/
*.pyc

# DABs-specific legacy entries (superseded by generic rules above — kept for clarity)
apps/dabs/src/build/
apps/dabs/src/dist/
apps/dabs/src/*.egg-info/
src/.infura_auth.txt
.history
**/*.pyc
**/*.pyo
**.log
/logs
venv*


mnt/airflow/logs
mnt/airflow/plugins
mnt/airflow/tmp
mnt/rosemberg/notebooks/spark-warehouse
mnt/rosemberg/warehouse
services/.secrets.conf
swarm.secrets.conf
dev.secrets.conf

z_old/
z_understanding.md
z_doc/
z_lib/

swarm.secrets_prod.conf
scripts/2_setup_firewall.sh
z_OLD_README.md

# Terraform — state local e credenciais
**/.terraform/
**/terraform.tfstate
**/terraform.tfstate.backup
# .terraform.lock.hcl is DELIBERATELY NOT ignored — every surviving root stack
# commits its provider lock file (SPEC B5/AC-15, T-R.2 F-06). A blanket ignore
# here would silently untrack the next stack's lock file with no signal.
**/secrets.tfvars
**/*.tfvars.local

# Credenciais nunca devem ser versionadas
*.pem
*.key
*.p12
*_credentials.json
services/conf/dev.secrets.conf

z_test.py

# Databricks CLI bundle cache

# Chaves e segredos locais — nunca versionados
valid/.env
valid/*.md
**/.env
**/*.env

# Arquivos de segredos de compose — nunca versionados
**/dev.secrets.conf
**/prod.secrets.conf
services/dev/compose/conf/dev.secrets.conf
services/prd/compose/conf/prd.secrets.conf

# Relatórios de segurança com exemplos de chaves — nunca versionados
/security.md
*_security_scan.md

# Airflow runtime config — varia por ambiente e contém credenciais de BD
mnt/airflow/airflow.cfg
dabs/.databricks/
# Terraform plan files
tfplan
*.tfplan

# Lake schemas workflow — estado local de idempotência (não versionar)
docs/.lake-schemas-hash

# dadaia-workspace runtime state — must never be inside a repo (workspace-root only)
.dadaia/

# specs_bkp/ — operator-approved transient backup from specs upgrade; delete after migration
specs_bkp/

# T-D.4/T-D.5 — reproducible build outputs, tool caches, Databricks CLI state.
# Never committed: CI (T-A.7) rebuilds the layer from source and uploads it to
# the artifacts bucket (T-B.14); Terraform reads it back by s3_key/sha256, not
# from a working-tree path.
.lambda_zip/
apps/**/*.zip
services/**/*.zip
.databricks/
.pytest_cache/
.mypy_cache/
.ruff_cache/
